{
  "name": "utoo-lint-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "docs:dev": "dumi dev",
    "docs:build": "dumi build",
    "site:build": "pnpm docs:build && pnpm playground:build && node scripts/assemble-site.mjs && node scripts/verify-site.mjs",
    "site:verify": "node scripts/verify-site.mjs",
    "build:wasm": "zig build wasm",
    "package:wasm": "bash scripts/package-wasm.sh",
    "stage:playground-wasm": "node scripts/stage-playground-wasm.mjs",
    "test:wasm": "zig build test-wasm",
    "playground:dev": "pnpm stage:playground-wasm && pnpm --filter @utoo/lint-playground dev",
    "playground:build": "pnpm stage:playground-wasm && pnpm --filter @utoo/lint-playground build",
    "playground:typecheck": "pnpm --filter @utoo/lint-playground typecheck",
    "bench:generate": "pnpm --dir benchmarks generate",
    "bench": "pnpm --dir benchmarks bench",
    "bench:chart": "pnpm --dir benchmarks chart"
  },
  "devDependencies": {
    "dumi": "2.4.49",
    "prism-react-renderer": "1.3.5",
    "prism-themes": "1.9.0",
    "wrangler": "4.126.0"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.14"
    }
  }
}
